# Txtbox project API key. Sent as the X-TXTBOX-Auth header on every request.
# Read by both the MCP server and the Skill curl-fallback path.
TXTBOX_API_KEY=

# Server log level: error | warn | info | debug. Default: info.
# debug logs include masked recipient and message length only — never the body.
TXTBOX_LOG_LEVEL=info

# Set to "1" to enable per-call allowNonPh:true bypass of PH phone validation.
# Off by default. The MCP tool also requires per-call allowNonPh:true, so this
# alone does NOT loosen validation — it just enables the per-call opt-in.
TXTBOX_ALLOW_NON_PH=
