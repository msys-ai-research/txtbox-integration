{
  "name": "@txtbox/mcp-server",
  "version": "0.2.0",
  "description": "Remote HTTP Model Context Protocol server for the Txtbox Philippine SMS platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:http": "vitest run test/http.test.ts",
    "test:integration": "vitest run test/sendSms.integration.test.ts",
    "lint:skill": "node scripts/lint-skill.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "esbuild": "0.21.5",
    "supertest": "7.0.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "txtbox",
    "sms",
    "philippines"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
